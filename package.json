{
  "name": "lavanotes",
  "productName": "LavaNotes",
  "version": "1.0.3",
  "description": "透明纸感桌面便签：错落倾斜的纸张、纸胶带、图片表格，完成就撕下",
  "main": "./out/main/index.js",
  "author": "chengcczzjj",
  "license": "MIT",
  "homepage": "https://github.com/chengcczzjj/LavaNotes",
  "repository": {
    "type": "git",
    "url": "https://github.com/chengcczzjj/LavaNotes.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "test:smoke": "npm run build && node tests/smoke/run-smoke.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7"
  }
}
